# OMC (oh-my-claudecode)
.omc/

# dryforge 로컬 워크트리/오케스트레이션 상태 (세션별 — 커밋 대상 아님)
.dryforge/

# Claude Code — share project config (settings.json, skills, agents, hooks) so a
# fresh clone reproduces the workflow; ignore only personal/local state.
# See docs/spec/workflow-reproducibility.
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# Codex hook runtime state
.codex/tmp/
.codex/hooks/state/

# Unity IL2CPP / build output (never ship, never commit)
/hello_BackUpThisFolder_ButDontShipItWithYourGame/
/.utmp/

# Non-tracked scratch screenshots (visual-verification captures)
/Assets/Screenshots/

# ── Project scratch / experiments (never commit) ────────────────────
# Burst debug output (name literally says DoNotShip)
*_BurstDebugInformation_DoNotShip/

# Superpowers tool scratch (brainstorm sessions, server state, etc.)
.superpowers/

# Recovery / sandbox experiment folders
/Assets/_Recovery/
/Assets/_Recovery.meta
/Assets/_Sandbox/
/Assets/_Sandbox.meta

# Default-named Unity junk (accidental "New X" assets)
/Assets/New Terrain.asset
/Assets/New Terrain.asset.meta
/Assets/**/New Material*.mat
/Assets/**/New Material*.mat.meta
/Assets/**/GameObject (*) Profile.asset
/Assets/**/GameObject (*) Profile.asset.meta

# BG_test scratch art + generated derivatives
/Assets/_Project/Art/BG_test*
/Assets/_Project/Generated/Props/BG_test*
/Assets/_Project/Generated/Props/Materials/BG_test*

# ChatGPT-generated scratch images
/Assets/**/ChatGPT Image*

# PaletteSanity sanity-check scene
/Assets/_Project/Scenes/PaletteSanity.unity
/Assets/_Project/Scenes/PaletteSanity.unity.meta

# Loose screenshot captures (Korean "스크린샷" prefix, scattered outside /Assets/Screenshots)
스크린샷*

# Orphan folder metas for scratch/empty generated folders
/Assets/_Project/Generated/Props/Materials.meta
/Assets/_Project/Generated/Tiles.meta
/Assets/_Project/Scenes/BattleScene.meta

# omx 플러그인 로컬 상태 (세션별 툴 상태 — 커밋 대상 아님)
/.omx/

# 로컬 작업 산출물 (시트 export/import 로그 등 — 커밋 대상 아님)
/tmp/
