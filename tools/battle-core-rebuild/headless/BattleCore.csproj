<Project Sdk="Microsoft.NET.Sdk">

  <!--
    battle-core-rebuild unit 1 — 헤드리스 컴파일 lane.

    같은 소스를 Unity 없이 컴파일한다. **정본 lane 은 Unity EditMode** 이고 이것은
    에디터가 없을 때(또는 도메인 리로드를 기다리기 싫을 때)의 반복 lane 이다.

    이 lane 이 성립하는 것 자체가 계약 4 의 증거다 — 엔진 참조가 하나라도 있으면
    여기서 먼저 빨개진다. `dotnet build` 가 「엔진 없음」의 컴파일 게이트다.

    Unity.Mathematics.dll 은 **메인 워크트리의 Library/ScriptAssemblies** 에서 가져온다.
    이 워크트리에는 Library 가 없다(에디터가 연 적이 없다). 다른 자리를 쓰려면
    `-p:UnityScriptAssemblies=<경로>`.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Wassup.BattleCore</AssemblyName>
    <RootNamespace>Wassup.BattleCore</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <RepoRoot>$(MSBuildThisFileDirectory)..\..\..\</RepoRoot>
    <UnityScriptAssemblies Condition="'$(UnityScriptAssemblies)' == ''">/Users/sy/dev/wassup/Library/ScriptAssemblies</UnityScriptAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- 코어 소스만 컴파일한다. Skills·UnitAi 는 에디터가 만든 dll 을 참조한다 — Unity asmdef 경계와 같은 집합이고, 소스를 다시 컴파일하면 Runtime.dll 이 아는 타입과 정체성이 갈린다(Unity 층 검사 lane 이 그것에 걸렸다). -->
    <Compile Include="$(RepoRoot)Assets\_Project\Scripts\BattleCore\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Wassup.Skills"><HintPath>$(UnityScriptAssemblies)/Wassup.Skills.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Wassup.UnitAi"><HintPath>$(UnityScriptAssemblies)/Wassup.UnitAi.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Unity.Mathematics">
      <HintPath>$(UnityScriptAssemblies)/Unity.Mathematics.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckUnityAssemblies" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(UnityScriptAssemblies)/Unity.Mathematics.dll')"
           Text="Unity.Mathematics.dll 이 '$(UnityScriptAssemblies)' 에 없다. 에디터가 한 번 컴파일한 워크트리의 Library/ScriptAssemblies 를 -p:UnityScriptAssemblies=... 로 가리켜라." />
  </Target>

</Project>
