<Project Sdk="Microsoft.NET.Sdk">

  <!--
    battle-core-rebuild unit 8c — 코드 도달성 검사 lane(「지울 수 있다」의 컴파일 증명).

    옛 전투가 지워진 **뒤의 트리**를 만든다: 클린 export 에서 `ledgers/retire-set.md` 의 퇴역 목록을 지우고
    (`check_ledgers.py retire-prune <export>`), 남는 Runtime + Editor + 테스트 전부를 **한 어셈블리로**
    Unity dll 에 대고 컴파일한다. 오류 0 = 남는 코드가 퇴역 목록의 어떤 타입도 부르지 않는다.
    C# 참조를 흉내 내지 않고 컴파일러에게 묻는다 — 이름이 같은 코어 사본(`GridMath`·`NavGrid`·`StatKind`…)을
    혼동할 여지가 없다.

    ⚠ `Somnia.Battle.Runtime.dll`·`Assembly-CSharp-Editor.dll`·`Somnia.Battle.Tests.*`·`Somnia.Battle.Editor.*` 는 **참조하지 않는다** —
    그 dll 들은 에디터가 옛 소스로 구운 것이라 퇴역 타입을 품고 있고, 참조하면 지운 타입이 dll 에서 보여
    거짓 초록이 난다. 그 어셈블리들은 전부 여기서 소스로 다시 컴파일된다.
    ⚠ 한 어셈블리로 합친다 — asmdef 경계(Runtime · Editor · 테스트 5)는 재현하지 않는다. 이 lane 이 묻는 것은
    「퇴역 타입을 부르나」 하나이고 경계 위반은 Unity 에디터가 잡는다.
    ⚠ Entities 계열 dll(Entities*·Transforms*·Serialization*·Hybrid)도 뺀다 — 참조하면 「남는 코드가 Entities 를 부르나」를 못 본다(unit 9 에서 잎 7 을 이렇게 놓쳤다).
    ⚠ 가지치기 안 한 트리에서는 돌지 않는다(`Scripts/Bridge` 가 있으면 즉시 실패) — 실수로 워크트리에 대고 돌려
    「초록」을 얻는 일을 막는다. 기준선(가지치기 전 트리도 이 한 어셈블리로 초록인가)을 잴 때만 `-p:AllowUnpruned=true`.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Somnia.Battle.Retire.Check</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1701;CS1702;CS0618;CS0612;CS0649;CS0169;CS0414;CS0067;CS0162;CS0168;CS0219;CS8321</NoWarn>
    <DefineConstants>UNITY_6000_4_3;UNITY_6000_4;UNITY_6000;UNITY_5_3_OR_NEWER;UNITY_5_4_OR_NEWER;UNITY_5_5_OR_NEWER;UNITY_5_6_OR_NEWER;UNITY_2017_1_OR_NEWER;UNITY_2017_2_OR_NEWER;UNITY_2017_3_OR_NEWER;UNITY_2017_4_OR_NEWER;UNITY_2018_1_OR_NEWER;UNITY_2018_2_OR_NEWER;UNITY_2018_3_OR_NEWER;UNITY_2018_4_OR_NEWER;UNITY_2019_1_OR_NEWER;UNITY_2019_2_OR_NEWER;UNITY_2019_3_OR_NEWER;UNITY_2019_4_OR_NEWER;UNITY_2020_1_OR_NEWER;UNITY_2020_2_OR_NEWER;UNITY_2020_3_OR_NEWER;UNITY_2021_1_OR_NEWER;UNITY_2021_2_OR_NEWER;UNITY_2021_3_OR_NEWER;UNITY_2022_1_OR_NEWER;UNITY_2022_2_OR_NEWER;UNITY_2022_3_OR_NEWER;UNITY_2023_1_OR_NEWER;UNITY_2023_2_OR_NEWER;UNITY_2023_3_OR_NEWER;UNITY_6000_0_OR_NEWER;UNITY_6000_1_OR_NEWER;UNITY_6000_2_OR_NEWER;UNITY_6000_3_OR_NEWER;UNITY_6000_4_OR_NEWER;PLATFORM_ARCH_64;UNITY_64;UNITY_INCLUDE_TESTS;ENABLE_AR;ENABLE_AUDIO;ENABLE_AUDIO_SCRIPTABLE_PIPELINE;ENABLE_CACHING;ENABLE_CLOTH;ENABLE_MICROPHONE;ENABLE_MULTIPLE_DISPLAYS;ENABLE_PHYSICS;ENABLE_TEXTURE_STREAMING;ENABLE_VIRTUALTEXTURING;ENABLE_LZMA;ENABLE_UNITYEVENTS;ENABLE_VR;ENABLE_WEBCAM;ENABLE_UNITYWEBREQUEST;ENABLE_WWW;ENABLE_CLOUD_SERVICES;ENABLE_CLOUD_SERVICES_ADS;ENABLE_CLOUD_SERVICES_USE_WEBREQUEST;ENABLE_UNITY_CONSENT;ENABLE_UNITY_CLOUD_IDENTIFIERS;ENABLE_CLOUD_SERVICES_CRASH_REPORTING;ENABLE_CLOUD_SERVICES_NATIVE_CRASH_REPORTING;ENABLE_CLOUD_SERVICES_PURCHASING;ENABLE_CLOUD_SERVICES_ANALYTICS;ENABLE_CLOUD_SERVICES_BUILD;ENABLE_EDITOR_GAME_SERVICES;ENABLE_UNITY_GAME_SERVICES_ANALYTICS_SUPPORT;ENABLE_CLOUD_LICENSE;ENABLE_EDITOR_HUB_LICENSE;ENABLE_WEBSOCKET_CLIENT;ENABLE_GENERATE_NATIVE_PLUGINS_FOR_ASSEMBLIES_API;ENABLE_DIRECTOR_AUDIO;ENABLE_DIRECTOR_TEXTURE;ENABLE_MANAGED_JOBS;ENABLE_MANAGED_TRANSFORM_JOBS;ENABLE_MANAGED_ANIMATION_JOBS;ENABLE_MANAGED_AUDIO_JOBS;ENABLE_MANAGED_UNITYTLS;INCLUDE_DYNAMIC_GI;ENABLE_SCRIPTING_GC_WBARRIERS;PLATFORM_SUPPORTS_MONO;RENDER_SOFTWARE_CURSOR;ENABLE_MARSHALLING_TESTS;ENABLE_VIDEO;ENABLE_NAVIGATION_OFFMESHLINK_TO_NAVMESHLINK;ENABLE_ACCELERATOR_CLIENT_DEBUGGING;ENABLE_ACCESSIBILITY_SCREEN_READER;TEXTCORE_1_0_OR_NEWER;EDITOR_ONLY_NAVMESH_BUILDER_DEPRECATED;PLATFORM_STANDALONE_OSX;PLATFORM_STANDALONE;UNITY_STANDALONE_OSX;UNITY_STANDALONE;ENABLE_GAMECENTER;ENABLE_RUNTIME_GI;ENABLE_MOVIES;ENABLE_NETWORK;ENABLE_CRUNCH_TEXTURE_COMPRESSION;ENABLE_CLOUD_SERVICES_ENGINE_DIAGNOSTICS;ENABLE_CLUSTER_SYNC;ENABLE_CLUSTERINPUT;ENABLE_SPATIALTRACKING;PLATFORM_HAS_CUSTOM_MUTEX;PLATFORM_UPDATES_TIME_OUTSIDE_OF_PLAYER_LOOP;PLATFORM_SUPPORTS_SPLIT_GRAPHICS_JOBS;PLATFORM_REQUIRES_PATH_NORMALIZATION;ENABLE_MONO;NET_4_6;NET_UNITY_4_8;ENABLE_PROFILER;ENABLE_PROFILER_ASSISTANT_INTEGRATION;DEBUG;TRACE;UNITY_ASSERTIONS;UNITY_EDITOR;UNITY_EDITOR_64;UNITY_EDITOR_OSX;ENABLE_UNITY_COLLECTIONS_CHECKS;ENABLE_BURST_AOT;UNITY_TEAM_LICENSE;ENABLE_CUSTOM_RENDER_TEXTURE;ENABLE_DIRECTOR;ENABLE_LOCALIZATION;ENABLE_SPRITES;ENABLE_TERRAIN;ENABLE_TILEMAP;ENABLE_TIMELINE;ENABLE_INPUT_SYSTEM;TEXTCORE_FONT_ENGINE_1_5_OR_NEWER;TEXTCORE_TEXT_ENGINE_1_5_OR_NEWER;TEXTCORE_FONT_ENGINE_1_6_OR_NEWER;UNITY_POST_PROCESSING_STACK_V2;CSHARP_7_OR_LATER;CSHARP_7_3_OR_NEWER;UNITY_EDITOR_ONLY_COMPILATION</DefineConstants>
    <RepoRoot>$(MSBuildThisFileDirectory)..\..\..\</RepoRoot>
    <UnityScriptAssemblies Condition="'$(UnityScriptAssemblies)' == ''">/Users/sy/dev/wassup-core/Library/ScriptAssemblies</UnityScriptAssemblies>
    <UnityPackageCache Condition="'$(UnityPackageCache)' == ''">/Users/sy/dev/wassup-core/Library/PackageCache</UnityPackageCache>
    <UnityContents Condition="'$(UnityContents)' == ''">/Applications/Unity/Hub/Editor/6000.4.3f1/Unity.app/Contents</UnityContents>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(RepoRoot)Assets\_Project\Scripts\**\*.cs"
             Exclude="$(RepoRoot)Assets\_Project\Scripts\BattleCore\**;$(RepoRoot)Assets\_Project\Scripts\Skills\**;$(RepoRoot)Assets\_Project\Scripts\UnitAi\**;$(RepoRoot)Assets\_Project\Scripts\SheetSync\**" />
    <Compile Include="$(RepoRoot)Assets\_Project\Editor\**\*.cs" />
    <Compile Include="$(RepoRoot)Assets\_Project\Tests\EditMode\**\*.cs;$(RepoRoot)Assets\_Project\Tests\EditModeAssets\**\*.cs;$(RepoRoot)Assets\_Project\Tests\EditModeCore\**\*.cs;$(RepoRoot)Assets\_Project\Tests\PlayMode\**\*.cs;$(RepoRoot)Assets\_Project\Tests\PlayModeCore\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="BattleCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(UnityContents)/Resources/Scripting/Managed/UnityEngine/*.dll" Private="false" />
    <!-- `Managed/UnityEngine/UnityEditor.dll` 이 모듈 파사드다 — 한 단계 위의 모놀리식 `Managed/UnityEditor.dll` 을 같이 넣으면 CS0433(`MenuItem` 이 둘). -->
    <Reference Include="$(UnityContents)/Resources/Scripting/Managed/UnityEditor.Graphs.dll" Private="false" />
    <!-- 패키지·벤더 어셈블리 전부 — 단 옛 소스로 구운 우리 어셈블리는 뺀다(머리말). Skills·UnitAi·SheetSync·DepthParallax 는 퇴역과 무관해 dll 로 받는다. -->
    <Reference Include="$(UnityScriptAssemblies)/*.dll"
               Exclude="$(UnityScriptAssemblies)/Somnia.Battle.Runtime.dll;$(UnityScriptAssemblies)/Somnia.Battle.BattleCore.dll;$(UnityScriptAssemblies)/Somnia.Battle.Tests.*.dll;$(UnityScriptAssemblies)/Somnia.Battle.Editor.*.dll;$(UnityScriptAssemblies)/Assembly-CSharp-Editor.dll;$(UnityScriptAssemblies)/*CodeGen*.dll;$(UnityScriptAssemblies)/Somnia.Battle.DepthParallax.Tests.dll;$(UnityScriptAssemblies)/Unity.Entities*.dll;$(UnityScriptAssemblies)/Unity.Transforms*.dll;$(UnityScriptAssemblies)/Unity.Serialization*.dll;$(UnityScriptAssemblies)/Unity.Mathematics.Extensions.Hybrid.dll;$(UnityScriptAssemblies)/Unity.PlasticSCM.Editor.Entities.dll" Private="false" />
    <!-- 모바일 빌드 CLI 가 플랫폼 확장을 부른다(Unity 생성 csproj 와 같은 집합). -->
    <Reference Include="$(UnityContents)/../../PlaybackEngines/AndroidPlayer/*.dll;$(UnityContents)/../../PlaybackEngines/iOSSupport/*.dll;$(UnityContents)/PlaybackEngines/MacStandaloneSupport/UnityEditor.OSXStandalone.Extensions.dll" Private="false" />
    <Reference Include="$(UnityPackageCache)/com.unity.ext.nunit@*/net40/unity-custom/nunit.framework.dll" Private="false" />
    <Reference Include="$(UnityPackageCache)/com.unity.nuget.newtonsoft-json@*/Runtime/Newtonsoft.Json.dll" Private="false" />
  </ItemGroup>

  <Target Name="RequirePrunedTree" BeforeTargets="BeforeBuild">
    <Error Condition="Exists('$(RepoRoot)Assets/_Project/Scripts/Bridge') And '$(AllowUnpruned)' != 'true'"
           Text="가지치기 안 한 트리다(Scripts/Bridge 가 있다). export 사본에서 'python3 tools/battle-core-rebuild/check_ledgers.py retire-prune &lt;export&gt;' 를 먼저 돌려라." />
  </Target>

</Project>
