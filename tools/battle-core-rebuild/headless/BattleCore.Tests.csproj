<Project Sdk="Microsoft.NET.Sdk">

  <!--
    battle-core-rebuild unit 1 — 헤드리스 테스트 lane.

    **Unity EditMode 와 같은 `.cs` 를 컴파일한다.** 그래서 테스트 소스는
    `NUnit.Framework` 와 코어 타입만 쓴다(`Tests/EditModeCore/README.md`).
    두 벌로 나뉘는 순간 한쪽만 초록인 상태가 생기고, 그게 가장 비싼 실패다.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <RepoRoot>$(MSBuildThisFileDirectory)..\..\..\</RepoRoot>
    <UnityScriptAssemblies Condition="'$(UnityScriptAssemblies)' == ''">/Users/sy/dev/wassup-core/Library/ScriptAssemblies</UnityScriptAssemblies>
    <!--
      골든 대조는 이 lane 에서 돌리지 않는다. Unity 의 Mono 는 float 식을 확장 정밀도로 평가해
      같은 코드가 .NET 9 와 1 ulp 부터 갈리고, 긴 판은 이벤트 순서까지 갈린다(kill_race_3min,
      9,887틱). 골든의 정본 런타임은 Unity EditMode 다 — `CoreGoldenTests` 주석 참조.
      이 lane 은 컴파일 + 규칙 테스트만 증언한다.
    -->
    <VSTestTestCaseFilter>TestCategory!=Golden</VSTestTestCaseFilter>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(RepoRoot)Assets\_Project\Tests\EditModeCore\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Wassup.Skills"><HintPath>$(UnityScriptAssemblies)/Wassup.Skills.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Wassup.UnitAi"><HintPath>$(UnityScriptAssemblies)/Wassup.UnitAi.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="BattleCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.MathematicsModule">
      <HintPath>$(UnityEngineDir)/UnityEngine.MathematicsModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
