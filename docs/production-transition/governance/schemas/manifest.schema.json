{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://somnia.local/schemas/dreamsquad-transition-manifest-v1.json",
  "title": "Dreamsquad immutable transition manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "freeze_id",
    "created_at",
    "demo_revision",
    "demo_content_sha256",
    "destinations",
    "bundle_hashes",
    "files"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "freeze_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "created_at": { "type": "string", "format": "date-time" },
    "demo_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "demo_content_sha256": { "$ref": "#/$defs/sha256" },
    "destinations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client", "game-server"],
      "properties": {
        "client": {
          "type": "string",
          "pattern": "^somnia-client/docs/migration-input/dreamsquad-demo/[A-Za-z0-9][A-Za-z0-9._-]*/$"
        },
        "game-server": {
          "type": "string",
          "pattern": "^somnia-game-server/docs/migration-input/dreamsquad-demo/[A-Za-z0-9][A-Za-z0-9._-]*/$"
        }
      }
    },
    "bundle_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["common", "client", "game-server"],
      "properties": {
        "common": { "$ref": "#/$defs/sha256" },
        "client": { "$ref": "#/$defs/sha256" },
        "game-server": { "$ref": "#/$defs/sha256" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "audience", "sha256", "bytes"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!.*\\/(?:[Aa][Rr][Cc][Hh][Ii][Vv][Ee]|[Mm][Aa][Ii][Nn][Tt][Ee][Nn][Aa][Nn][Cc][Ee]|[Ff][Ii][Xx][Tt][Uu][Rr][Ee][Ss]?|[Ee][Vv][Ii][Dd][Ee][Nn][Cc][Ee])(?:/|$))(common|client|game-server|references)/(?!.*//)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^\\\\\\u0000-\\u001F\\u007F-\\u009F]+\\.md$"
        },
        "audience": { "enum": ["common", "client", "game-server", "reference"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": ["path", "audience"],
              "properties": {
                "audience": { "const": "common" },
                "path": { "pattern": "^common/" }
              }
            },
            {
              "required": ["path", "audience"],
              "properties": {
                "audience": { "const": "client" },
                "path": { "pattern": "^client/" }
              }
            },
            {
              "required": ["path", "audience"],
              "properties": {
                "audience": { "const": "game-server" },
                "path": { "pattern": "^game-server/" }
              }
            },
            {
              "required": ["path", "audience"],
              "properties": {
                "audience": { "const": "reference" },
                "path": { "const": "references/transition-policy.md" }
              }
            }
          ]
        }
      ]
    }
  }
}
