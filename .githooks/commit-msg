#!/bin/sh
# battle-core-rebuild unit 0 — 옛 전투 동결 훅 (README 계약 10).
# 스테이징에 옛 전투 경로가 있으면 커밋 메시지 첫 줄에 [old-battle] 태그를 요구한다.
# 설치: git config core.hooksPath .githooks   (클론/워크트리마다 1회, 워크트리는 공용 config 를 따른다)
FROZEN='^Assets/_Project/Scripts/(Battle|Bridge)/'
staged=$(git diff --cached --name-only | grep -E "$FROZEN")
[ -z "$staged" ] && exit 0
first=$(sed -n '1p' "$1")
case "$first" in
  *"[old-battle]"*) exit 0 ;;
esac
echo "" >&2
echo "✖ 옛 전투(Scripts/Battle · Bridge)는 동결 상태입니다 — battle-core-rebuild 계약 10." >&2
echo "  스테이징된 옛 전투 파일:" >&2
echo "$staged" | sed 's/^/    /' >&2
echo "  버그픽스면 커밋 메시지 첫 줄에 [old-battle] 태그를 붙이고, 규칙 변경이면 새 전투 코어(Scripts/BattleCore)에서 하세요." >&2
exit 1
